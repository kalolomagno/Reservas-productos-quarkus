APP_DB_USERNAME=reservation_user
APP_DB_PASSWORD=replace-with-local-password
APP_DB_JDBC_URL=jdbc:postgresql://replace-with-localhost/db_reservation

APP_OPERATOR_CLIENT_ID=reservation-operator
APP_OPERATOR_CLIENT_SECRET=replace-with-local-operator-secret

APP_ADMIN_CLIENT_ID=reservation-admin
APP_ADMIN_CLIENT_SECRET=replace-with-local-admin-secret

APP_JWT_PRIVATE_KEY_LOCATION=file:../security/private.key
APP_JWT_PUBLIC_KEY_LOCATION=file:../security/public.key
